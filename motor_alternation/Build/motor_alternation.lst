**************************************************
	List function block: CTU_UDINT
**************************************************

FUNCTION_BLOCK CTU_UDINT

	{ DE:"<HTML>(Same as CTU but with PV and CV of <b>UDINT</b> data type)<br/><br/>
The CTU_UDINT block <b>counts up</b> for each FALSE-to-TRUE transition of the input CU and sets the output Q when the accumulated value (CV) reaches the preset value (PV) value.<br/>
<img src= ctuscheme.png>
<ul>
<li>rising edge of R reset CV to 0</li>
<li>rising edge of CU increments CV by 1</li>
<li>when CV reaches PV the output Q is set</li>
<li>once CV is equal to PV its value remains until a rising edge of R</li>
</ul>" }

        VAR_INPUT
CU : BOOL;	{ DE:"Count-up on input rising edge" }
R : BOOL;	{ DE:"Reset counter input" }
PV : UDINT;	{ DE:"Preset value" }
	END_VAR

        VAR_OUTPUT
Q : BOOL;	{ DE:"Count-up output" }
CV : UDINT;	{ DE:"Counter current value" }
	END_VAR

        VAR
CUEDGE : BOOL;
MEMCU : BOOL;
	END_VAR

END_FUNCTION_BLOCK

